{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "replicate from mongo to supabase",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "args": ["replicate"],
            "env": {
                "MONGO_URI": "${env:MONGO_URI}",
                "SUPABASE_CONNECTION_STRING": "${env:SUPABASE_CONNECTION_STRING}"
            },
            "console": "integratedTerminal"
        }
    ]
}